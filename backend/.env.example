# Entorno: development | test | production
NODE_ENV=development
PORT=4000

# Base de datos
# En desarrollo se usa SQLite (archivo data/myk.sqlite3), no requiere instalación.
# En producción se usa PostgreSQL (por ejemplo Neon): pegue aquí la cadena de conexión.
DATABASE_URL=

# Seguridad: cambie este valor por una cadena larga y aleatoria
JWT_SECRET=cambie-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,https://bryanstithquintero.github.io
