{
  "name": "myk-backend",
  "version": "1.0.0",
  "description": "API REST de MYK – Control de Ventas e Inventario (Salsamentaria MYK)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "seed": "knex --knexfile knexfile.js seed:run",
    "db:reset": "knex --knexfile knexfile.js migrate:rollback --all && knex --knexfile knexfile.js migrate:latest && knex --knexfile knexfile.js seed:run",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.js"
  },
  "author": "Bryan Stith Quintero Guacary",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "supertest": "^7.3.2"
  }
}
